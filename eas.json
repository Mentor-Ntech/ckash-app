{
  "cli": {
    "version": ">= 3.13.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient":true,
      "environment": "development",
      "distribution":"internal",
      "channel":"development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
      
    },
    "production": {
      "node": "20.17.0",
      "autoIncrement": true,
      "distribution": "store",
      "environment":"production"     
    },
    "e2e": {
      "withoutCredentials": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6738967491"
      }
    }
  }
}
